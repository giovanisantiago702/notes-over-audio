{
  "manifest_version": 3,
  "name": "Notes over audio",
  "version": "0.1",
  "description": "Highlights and Notes on a YouTube video's Transcript, kept where they were said.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["sidePanel", "storage"],
  "action": { "default_title": "Open Notes over audio" },
  "background": { "service_worker": "extension/service-worker.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["extension/youtube-page.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["extension/youtube-player.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
